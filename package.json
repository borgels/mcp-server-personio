{
  "name": "mcp-server-personio",
  "version": "0.2.0",
  "mcpName": "io.github.borgels/mcp-server-personio",
  "description": "MCP server for the Personio HR API with employee and HR-admin profiles.",
  "type": "module",
  "main": "./dist/stdio.js",
  "exports": {
    ".": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "bin": {
    "mcp-server-personio": "./dist/stdio.js"
  },
  "scripts": {
    "build": "tsup src/transports/stdio.ts src/transports/http.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/transports/stdio.ts",
    "dev:http": "tsx src/transports/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepack": "npm run typecheck && npm test && npm run build",
    "smoke:live": "tsx test/live-smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borgels/mcp-server-personio.git"
  },
  "keywords": [
    "mcp",
    "personio",
    "hr",
    "absence",
    "time-tracking"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "bugs": {
    "url": "https://github.com/borgels/mcp-server-personio/issues"
  },
  "homepage": "https://github.com/borgels/mcp-server-personio#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "ip-address": "^10.1.1",
    "hono": "^4.13.19",
    "@hono/node-server": "^2.1.8",
    "fast-uri": "^3.1.9",
    "qs": "^6.17.1",
    "body-parser": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
