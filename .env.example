# API credentials: Personio Settings -> Integrations -> API credentials.
# The same pair authenticates v2 (OAuth2) and the few remaining v1 endpoints.
PERSONIO_CLIENT_ID=
PERSONIO_CLIENT_SECRET=
PERSONIO_BASE_URL=https://api.personio.de
# Upstream request timeout in milliseconds (1-600000).
PERSONIO_TIMEOUT_MS=30000
# Tool profile: "employee" (self-service, hard-scoped to the requesting
# user's own data) or "hr" (company-wide HR workbench).
PERSONIO_PROFILE=employee
# Honor the gateway-forwarded X-MCP-User header as the acting identity.
# Required for the employee profile; only enable behind a gateway that
# sets this header itself from a verified token.
# When true, the HTTP transport refuses to start unless MCP_HTTP_TOKEN is set.
PERSONIO_TRUST_FORWARDED_USER=false
# HR profile only: confine the instance to one legal entity id ("all" or
# empty = unscoped).
PERSONIO_HR_LEGAL_ENTITY=
# HR write tools (update person, manage absence/attendance/projects,
# upload documents) additionally require exactly "true".
PERSONIO_ENABLE_WRITES=false
PERSONIO_AUDIT_LOG=

# Streamable HTTP transport. Binds to loopback by default.
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
# Bearer token for /mcp: at least 32 printable ASCII characters
# (e.g. `openssl rand -hex 32`). Required when MCP_HTTP_HOST is not a loopback
# address, when MCP_ALLOW_ANY_ORIGIN=true and when
# PERSONIO_TRUST_FORWARDED_USER=true; the server refuses to start otherwise.
MCP_HTTP_TOKEN=
# Start without a token where one would be required. Only when access is
# restricted by other means.
MCP_HTTP_ALLOW_UNAUTHENTICATED=false
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
# Host header allowlist (host names, no port). Default: localhost names on a
# loopback bind, no check otherwise.
MCP_ALLOWED_HOSTS=
# Failed auth attempts per client address per window before 429; 0 disables.
MCP_AUTH_FAILURE_LIMIT=20
MCP_AUTH_FAILURE_WINDOW_MS=60000
